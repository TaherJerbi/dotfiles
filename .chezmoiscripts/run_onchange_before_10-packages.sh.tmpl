#!/usr/bin/env bash
# Installs the pieces mise has no entry for -- a C toolchain, the login shell,
# the GUI terminal -- plus mise itself. Everything else goes through mise,
# installed by run_onchange_after_20-mise.sh.
# Report-only counterpart: ~/.config/setup/doctor.sh.
set -euo pipefail
{{ $fam := .pkgfamily -}}
{{ $pm := dig $fam (dict) .packagemanagers -}}

{{ template "system-packages.sh" . }}

{{ if eq $fam "brew" -}}
CASKS="
{{- range .tools }}
{{- if and (hasKey . "cask") (or (not (hasKey . "hosts")) (has $.host .hosts)) }}
{{ .cmd }}|{{ if hasKey . "pkg" }}{{ dig $fam (dig "default" .cmd .pkg) .pkg }}{{ else }}{{ .cmd }}{{ end }}
{{- end }}
{{- end }}
"
while IFS='|' read -r cmd pkg; do
  [ -z "$cmd" ] && continue
  have_cmd "$cmd" && continue
  echo "Installing cask $pkg"
  {{ $pm.installcask }} "$pkg"
done <<EOF
$CASKS
EOF
{{ end -}}

{{ if eq .host "devpod" -}}
# mise carries every other tool, so it has to exist before the after-script
# runs. On the devpod it lives under $HOME: only /mnt/persistent (= $HOME)
# survives a pod rebuild, so /usr/local/bin would lose it.
if ! command -v mise >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/mise" ]; then
  echo "missing: mise (installs every other tool)"
  curl -fsSL https://mise.run | sh
fi
{{- else -}}
# mise carries every other tool, so it has to exist before the after-script
# runs. It goes somewhere root can reach: the after-script installs tools
# system-wide with sudo, and root's PATH is not the user's.
# A mise under $HOME does not count. Left over from when this repo installed
# it per-user, it would otherwise satisfy this check forever and the system
# install would never happen.
mise_path=$(command -v mise 2>/dev/null || true)
case "$mise_path" in
  "" | "$HOME"/*) mise_path="" ;;
esac
if [ -z "$mise_path" ] && [ ! -x /usr/local/bin/mise ]; then
  echo "missing: mise (installs every other tool)"
{{- if eq $fam "brew" }}
  brew install mise
{{- else if eq $fam "arch" }}
  sudo pacman -Sy mise --noconfirm --needed
{{- else }}
  curl -fsSL https://mise.run | sudo MISE_INSTALL_PATH=/usr/local/bin/mise sh
{{- end }}
fi
{{- end }}
