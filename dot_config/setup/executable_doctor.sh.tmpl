#!/usr/bin/env bash
# Reports on the tools this repo's configs rely on; installs nothing. The
# required list comes from the same .chezmoidata/packages.yaml as the install
# script, .chezmoiscripts/run_onchange_before_10-packages.sh.tmpl.
#
#   ~/.config/setup/doctor.sh
set -euo pipefail

report() { printf '  %-12s %-8s %s\n' "$1" "$2" "$3"; }
have() { command -v "$1" >/dev/null 2>&1; }
check() { if have "$1"; then report "$1" ok "$2"; else report "$1" MISSING "$2"; fi; }

# cmd|alternative binary name|reason
REQUIRED="
{{- range .tools }}
{{ .cmd }}|{{ if hasKey . "alt" }}{{ .alt }}{{ end }}|{{ .reason }}
{{- end }}
"

echo "Machine identity: ${DOTS_HOST:-(unset)}"
echo "Machine osid:     {{ .osid }}   packages: {{ .pkgfamily | default "(none -- unrecognised distro)" }}"
if [ -r /etc/os-release ]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  echo "Distribution:     ${PRETTY_NAME:-${ID:-unknown}}"
fi
echo
echo "Required (installed by chezmoi's package script)..."
while IFS='|' read -r cmd alt reason; do
  [ -z "$cmd" ] && continue
  if have "$cmd"; then
    report "$cmd" ok "$reason"
  elif [ -n "$alt" ] && have "$alt"; then
    report "$cmd" "as $alt" "$reason -- chezmoi's package script links it to ~/.local/bin/$cmd"
  else
    report "$cmd" MISSING "$reason"
  fi
done <<EOF
$REQUIRED
EOF

# On 0.11 init.lua aborts with "Invalid 'event': 'PackChanged'".
if have nvim; then
  ver="$(nvim --version | head -1 | sed 's/^NVIM v//')"
  major="${ver%%.*}"; rest="${ver#*.}"; minor="${rest%%.*}"
  if [ "$major" -eq 0 ] && [ "$minor" -lt 12 ]; then
    report nvim "TOO OLD" "have $ver, need >= 0.12 (vim.pack); upgrade neovim"
  fi
fi

echo
echo "Optional / not package-managed..."
check herdr "install manually and ensure it's on PATH"
for cmd in fzf jq eza bat; do
  check "$cmd" "herdr workspace switcher"
done

case "$(uname -s)" in
  Darwin)
    check pbcopy "'\"+y' clipboard yank in nvim"
    if [ -d "/Applications/Karabiner-Elements.app" ]; then
      report karabiner ok "reads karabiner/karabiner.json"
    else
      report karabiner MISSING "brew install --cask karabiner-elements"
    fi
    ;;
  Linux)
    if have xclip || have xsel || have wl-copy; then
      report clipboard ok "'\"+y' clipboard yank in nvim"
    else
      report clipboard MISSING "install xclip (X11) or wl-clipboard (Wayland)"
    fi
    ;;
esac

echo
echo "A Nerd Font is optional but recommended for icons; see https://www.nerdfonts.com/"
