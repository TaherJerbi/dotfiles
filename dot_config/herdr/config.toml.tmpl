# herdr configuration

# First-run notification setup already chosen; don't show it again.
onboarding = false

[theme]
name = "terminal"

{{ if eq .host "devpod" -}}
[terminal]
# ttyd doesn't export SHELL, and herdr's fallback when $SHELL is unset is
# /bin/sh — so name bash explicitly.
default_shell = "/bin/bash"
{{- end }}

[keys]
# Prefix key to enter prefix mode (default: "ctrl+b")
prefix = "ctrl+z"

# Jump back to the last focused pane (unset by default)
last_pane = "prefix+l"

# prefix+g and prefix+r go to worktrunk's worktree actions below.
goto = ""
resize_mode = ""

# Don't prompt for a tab name on creation; tabs get their auto-numbered label
[ui]
prompt_new_tab_name = false

# Play sounds when agents change state in background workspaces
[ui.sound]
enabled = false

# sesh-style picker: fuzzy-find an open workspace or a zoxide-known
# directory; creates or focuses a workspace there.
[[keys.command]]
key = "prefix+f"
type = "popup"
command = "herdr-workspace-switcher"
description = "workspace / directory switcher"
width = "70%"
height = "70%"

# worktrunk's worktree actions, which run its hooks. A [[keys.command]]
# silently wins over a default -- `herdr config check` only reports collisions
# between two explicit entries -- so the defaults they replace are unset above.
# prefix+shift+g replaces the built-in new_worktree.
[[keys.command]]
key = "prefix+g"
type = "plugin_action"
command = "worktrunk.open"
description = "worktree: switch or create from default branch"

[[keys.command]]
key = "prefix+shift+g"
type = "plugin_action"
command = "worktrunk.open-current"
description = "worktree: switch or create from current branch"

[[keys.command]]
key = "prefix+r"
type = "plugin_action"
command = "worktrunk.remove"
description = "worktree: remove"
