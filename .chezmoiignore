# Targets chezmoi must never create, overwrite, or remove. These are all
# machine-local: generated by a tool, or holding a per-machine secret.

# fish's own universal-variable store, rewritten by fish itself.
.config/fish/fish_variables

# Machine-local fish overrides. Holds secrets (e.g. BW_SESSION); deliberately
# never committed. Create it by hand on a new box.
.config/fish/conf.d/local.fish

# Karabiner-Elements' own rolling backups of karabiner.json.
.config/karabiner/automatic_backups

# Karabiner-Elements is macOS-only.
{{ if ne .chezmoi.os "darwin" }}
.config/karabiner
{{ end }}

# herdr runtime state.
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/.plugins.lock
.config/herdr/session.json
# herdr's plugin registry and clones, built from plugins.list.
.config/herdr/plugins.json
.config/herdr/plugins

# Machine-local bash config (secrets); never committed.
.config/bash/local.bash

# Alacritty's auto-generated config-migration backups.
.config/alacritty/*.bak

# rofi is X11/Wayland, so rofimoji.rc is only ever wanted on Linux.
{{ if ne .chezmoi.os "linux" }}
.config/rofimoji.rc
{{ end }}

# My skills live in ~/.agents/skills so any agent harness can use them; each
# harness gets a symlink to them (~/.claude/skills/<name>), made by
# run_onchange_after_30-skill-links.sh. Skills installed by the `skills` CLI
# (npx skills) are its business, not mine.
.agents/.skill-lock.json
.agents/skills/herdr

# Claude Code keeps credentials, chat history and session state next to its
# config. Only settings.json and the status line are tracked; this keeps a
# stray `chezmoi add ~/.claude` from picking up the rest, including skills
# that aren't mine (~/.claude/skills/synced, the work monorepo's) and work-only
# files kept untracked on purpose (CLAUDE.md, hades-pages).
.claude/*
!.claude/settings.json
!.claude/statusline.sh

# Skills only some machines get; see .chezmoidata/skills.yaml.
{{- range $name, $hosts := .skillhosts }}
{{-   if not (has $.host $hosts) }}
.agents/skills/{{ $name }}
{{-   end }}
{{- end }}

# The devpod: bash rather than fish, a browser terminal (ttyd) rather than
# Alacritty, and a pod start hook.
{{ if eq .host "devpod" }}
# ~/.claude is a symlink the pod's tooling owns (to ~/.claude-subscription);
# chezmoi would replace it with a directory. Skills still get linked into it.
.claude
.config/alacritty
.config/fish
.config/rofimoji
.config/rofimoji.rc
{{ else }}
.bashrc
.bash_aliases
.inputrc
.ttyd.yaml
.poseidon_init
.config/setup/devpod-deps.sh
.config/nvim/osc52copy.sh
.config/nvim/lua/personal/devpod.lua
{{ end }}

# Repo documentation, not a dotfile. Without this chezmoi would write it to
# ~/README.md.
README.md
