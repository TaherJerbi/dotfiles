# Ignore everything
*

# Include .gitignore
!/.gitignore

# Include nvim config (and its contents)
!/nvim/
!/nvim/**
# Include karabiner config
!/karabiner/
!/karabiner/*

# Include herdr config (and its contents)
!/herdr/
!/herdr/**

# But ignore herdr runtime/state files
/herdr/*.log
/herdr/*.sock
/herdr/.plugins.lock
/herdr/session.json
