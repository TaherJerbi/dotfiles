# Ignore everything
*

# Include .gitignore
!/.gitignore

# Include the top-level README
!/README.md

# Include the dependency-check/install scripts (shared + per-machine)
!/setup/
!/setup/**

# Include nvim config (and its contents)
!/nvim/
!/nvim/**
# Include karabiner config
!/karabiner/
!/karabiner/*

# Include fish config (and its contents)
!/fish/
!/fish/**

# But ignore fish's machine-local universal variables state
/fish/fish_variables

# Include alacritty config (and its contents)
!/alacritty/
!/alacritty/**

# But ignore alacritty's auto-generated config migration backups
/alacritty/*.bak

# Include herdr config (and its contents)
!/herdr/
!/herdr/**

# But ignore herdr runtime/state files
/herdr/*.log
/herdr/*.sock
/herdr/.plugins.lock
/herdr/session.json

# Include rofimoji config (and its contents)
!/rofimoji/
!/rofimoji/**

# But ignore machine-local fish overrides (secrets)
/fish/conf.d/local.fish

# Ignore the machine identity file (one word: macos, cachyos, parrotos, ...).
# It's per-machine by definition; ./setup.sh prompts for it.
# Note the per-host configs it selects, /fish/conf.d/host/*.fish, ARE tracked.
/host

# But ignore machine-local alacritty overrides (shell path differs per host)
/alacritty/local.toml
